# Leave empty to use the Vite dev proxy (/api -> backend). Recommended for local development.
VITE_API_BASE_URL=

# Backend URL used by the Vite proxy in development (see vite.config.js)
VITE_DEV_API_PROXY=http://localhost:5022

# Use only for production builds or if you intentionally bypass the Vite proxy:
# VITE_API_BASE_URL=https://localhost:7120
# VITE_API_BASE_URL=http://localhost:5022
